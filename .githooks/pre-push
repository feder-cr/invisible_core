#!/bin/sh
# Refuse to push a release tag whose publish gate is red.
#
# WHY A HOOK AT ALL
# -----------------
# scripts/version_gate.py used to be wired to nothing: the script existed, its
# test existed, and every path to an actual upload went around it. A gate that
# needs the operator to remember it is a runbook note.
#
# This is the first of three layers, and the earliest one. A release tag is what
# starts .github/workflows/publish.yml, so refusing the tag here means the
# release never even begins - no half-built artifact, no draft to clean up.
# Layer two is the workflow, whose upload job cannot start without the gate job.
# Layer three is `version_gate.py publish`, which runs the gate in-process and
# never reaches twine on a refusal.
#
# Only release tags are gated. Ordinary branch pushes are left alone on purpose:
# the gate builds the project twice, and a hook that costs a minute on every
# push is a hook people delete.
#
# Install: python scripts/install_hooks.py   (sets core.hooksPath to .githooks)
# tests/test_release_wiring.py fails in an uninstalled checkout, so nobody has
# to remember to run it - the test suite says so.

# No `set -e`: the gate's exit code has to be READ and explained, not turned
# into a silent abort. Every other failure below is handled explicitly.
repo_root=$(git rev-parse --show-toplevel)
gate="$repo_root/scripts/version_gate.py"

python_bin=""
for candidate in "$INVISIBLE_GATE_PYTHON" python3 python py; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1; then
        python_bin="$candidate"
        break
    fi
done

release_tag=""
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/tags/v*|refs/tags/release-*)
            release_tag="$remote_ref"
            ;;
    esac
done

# ── forbidden names ────────────────────────────────────────────────────
# Naming a protection vendor or a target site in a public repo is a legal and
# credibility problem, and no test in this package covers it. It cannot be a
# test here either: the scanner needs a word list that deliberately lives
# outside every public repo.
#
# THREE cases, kept apart on purpose. The first cut of this had only two and
# refused whenever the script was not at the default path - which meant every
# clone of the PUBLIC repo was blocked on every push with no way to comply
# except switching the gate off. That is the same "red by default, so people
# route around it" failure the guard was moved out of the test suite to avoid.
#
#   configured (INVISIBLE_NAME_CHECK set) but unreachable -> REFUSE. Somebody
#       meant this to run and it did not.
#   present at the default path                           -> RUN, refuse on any
#       non-zero: the script exits 2 rather than 0 when it could not scan.
#   neither                                               -> this is not the
#       workbench; there is no word list here and nothing to enforce. Say so in
#       one line and carry on. Silence would be the actual failure.
NAME_CHECK="${INVISIBLE_NAME_CHECK:-../../scripts/check_forbidden_names.py}"
NAME_SKIPPED=""

if [ "$INVISIBLE_NAME_CHECK" = "skip" ]; then
    echo ""
    echo "[pre-push] ###################################################################"
    echo "[pre-push] # WARNING: INVISIBLE_NAME_CHECK=skip                              #"
    echo "[pre-push] # Nothing checked this push for vendor or target-site names. If   #"
    echo "[pre-push] # one is in the diff it is public the moment this lands, and a    #"
    echo "[pre-push] # force-push does not remove it - GitHub keeps the object.        #"
    echo "[pre-push] ###################################################################"
    echo ""
    NAME_SKIPPED=yes
elif [ -n "$INVISIBLE_NAME_CHECK" ] && [ ! -f "$NAME_CHECK" ]; then
    echo "" >&2
    echo "[pre-push] REFUSED - INVISIBLE_NAME_CHECK is set but points at nothing." >&2
    echo "[pre-push]   looked for: $NAME_CHECK" >&2
    echo "[pre-push]   from:       $(pwd)" >&2
    echo "[pre-push] Fix the path, or set INVISIBLE_NAME_CHECK=skip to state on the" >&2
    echo "[pre-push] record that this push is going out unscanned." >&2
    exit 1
elif [ ! -f "$NAME_CHECK" ]; then
    echo "[pre-push] no forbidden-name word list here, so nothing scanned this push."
    echo "[pre-push] (that scan is a maintainer gate; it lives outside this repo.)"
    NAME_SKIPPED=yes
else
    echo "[pre-push] scanning shipped files for names we do not publish..."
    if ! python "$NAME_CHECK" .; then
        echo "" >&2
        echo "[pre-push] REFUSED - see above. The offending files are named; the" >&2
        echo "[pre-push] tokens are not, so this log is safe to paste." >&2
        exit 1
    fi
fi

[ -n "$release_tag" ] || exit 0

echo "pre-push: $release_tag is a release tag, running the publish gate."

if [ -z "$python_bin" ]; then
    echo "pre-push: REFUSED - no python on PATH, so the publish gate cannot run." >&2
    echo "  A release tag must never be pushed past an ungated hook. Set" >&2
    echo "  INVISIBLE_GATE_PYTHON to an interpreter and push again." >&2
    exit 1
fi
if [ ! -f "$gate" ]; then
    echo "pre-push: REFUSED - $gate is missing, so the gate cannot run." >&2
    exit 1
fi

"$python_bin" "$gate" check || rc=$?
rc=${rc:-0}

# 0 is the only pass. 1 refused, 2 gate broken, 4 no usable ledger - none of
# those is a green light, and a broken gate is not a reason to proceed either.
if [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: REFUSED - the publish gate exited $rc, so $release_tag is not" >&2
    echo "  going anywhere. Pushing it would start the publish workflow." >&2
    echo "  Read the gate output above; it names the file and the remedy." >&2
    exit 1
fi

echo "pre-push: gate passed."
exit 0
